<?xml version="1.0" ?>
<sdf version="1.4">
  
  <!-- We use a custom world for the mr1d so that the camera angle is launched correctly -->
  <world name="mr1d_gazebo_world">
    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    
    <!-- Global light source -->
    <include>
      <uri>model://sun</uri>
    </include>
    
    <!-- Focus camera on mr1d -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>0.5 -0.5 0.3 0.000000 0.275643 2.356190</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
    
    <!-- MR1D SDF model -->
    <model name='mr1d'>
      <include>
        <uri>model://mr1d</uri>
      </include>
    </model>
  </world>
  
</sdf>
